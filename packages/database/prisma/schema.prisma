generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANCY & CORE
// ============================================================================

model Tenant {
  id     String       @id @default(cuid())
  code   String       @unique
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)
  tier   TenantTier   @default(SHARED)
  enabledModules String[] @default(["dashboard", "students", "classes", "attendance", "assessments", "finance", "announcements"])

  email   String?
  phone   String?
  address String?
  country String  @default("ET")
  region  String?
  timezone String @default("Africa/Addis_Ababa")
  locale   String @default("am")

  logoUrl        String?
  primaryColor   String? @default("#4F46E5")
  secondaryColor String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  // Relations
  website              SchoolWebsite?
  userTenants          UserTenant[]
  students             Student[]
  teachers             TeacherProfile[]
  parents              ParentProfile[]
  classes              Class[]
  subjects             Subject[]
  timetables           Timetable[]
  attendance           Attendance[]
  assessments          Assessment[]
  grades               Grade[]
  invoices             Invoice[]
  payments             Payment[]
  expenses             Expense[]
  messages             Message[]
  notifications        Notification[]
  announcements        Announcement[]
  broadcasts           Broadcast[]
  assignments          Assignment[]
  submissions          Submission[]
  books                Book[]
  bookLoans            BookLoan[]
  transportRoutes      TransportRoute[]
  vehicles             Vehicle[]
  transportAssignments TransportAssignment[]
  leaveRequests        LeaveRequest[]
  payslips             Payslip[]
  assets               Asset[]
  assetMaintenance     AssetMaintenance[]
  hostelBlocks         HostelBlock[]
  hostelRooms          HostelRoom[]
  hostelAllocations    HostelAllocation[]
  hostelCheckIns       HostelCheckIn[]
  ptmEvents            PTMEvent[]
  ptmSlots             PTMSlot[]
  ptmBookings          PTMBooking[]
  behaviorLogs         BehaviorLog[]
  healthRecords        HealthRecord[]
  clinicVisits         ClinicVisit[]
  auditLogs            AuditLog[]
  admissionApplications AdmissionApplication[]
  visitorLogs          VisitorLog[]
  gatePasses           GatePass[]
  studentWallets       StudentWallet[]
  walletTransactions   WalletTransaction[]
  menuItems            MenuItem[]
  clubs                Club[]
  clubMemberships      ClubMembership[]
  fundraisingCampaigns FundraisingCampaign[]
  donations            Donation[]
  dailyLogs            DailyLog[]
  examRooms            ExamRoom[]
  examSchedules        ExamSchedule[]
  examSeats            ExamSeat[]
  forms                Form[]
  formSubmissions      FormSubmission[]
  schoolEvents         SchoolEvent[]
  certificates         Certificate[]
  gradingScales        GradingScale[]
  substituteAssignments SubstituteAssignment[]
  cbtExams             CBTExam[]
  cbtQuestions         CBTQuestion[]
  cbtAttempts          CBTAttempt[]
  studentAnswers       StudentAnswer[]

  @@index([status, deletedAt])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING
}

enum TenantTier {
  SHARED
  SCHEMA
  DEDICATED_DB
  DEDICATED_SERVER
}

model SchoolWebsite {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  heroTitle   String   @default("Welcome to Our School")
  heroSubtitle String  @default("Nurturing the leaders of tomorrow.")
  aboutText   String   @db.Text @default("We are a premier educational institution dedicated to academic excellence and character development.")
  contactPhone String?
  contactEmail String?
  contactAddress String?
  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("school_websites")
}

// ============================================================================
// IDENTITY & USERS
// ============================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  status        UserStatus @default(ACTIVE)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  profile            UserProfile?
  tenantLinks        UserTenant[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  mfaDevices         MFADevice[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  
  teacherProfile     TeacherProfile?
  parentProfile      ParentProfile?
  
  messages           Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")
  notifications      Notification[]
  assignedAssets     Asset[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]

  @@index([status, deletedAt])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  middleName  String?
  photoUrl    String?
  phone       String?
  dateOfBirth DateTime?
  gender      Gender?
  locale      String  @default("am")
  timezone    String  @default("Africa/Addis_Ababa")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model UserTenant {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status   UserTenantStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  leftAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserTenantRole[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenants")
}

enum UserTenantStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model UserTenantRole {
  id           String     @id @default(cuid())
  userTenantId String
  userTenant   UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  scope Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userTenantId, roleId])
  @@index([userTenantId])
  @@index([roleId])
  @@map("user_tenant_roles")
}

model Role {
  id          String  @id @default(cuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions     RolePermission[]
  userTenantRoles UserTenantRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  slug        String @unique
  description String

  category String
  resource String
  action   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([category])
  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String

  deviceInfo Json
  lastIp     String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model MFADevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       MFAType @default(TOTP)
  name       String
  secret     String?
  publicKey  String?
  credential String?

  verifiedAt DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("mfa_devices")
}

enum MFAType {
  TOTP
  SMS
  EMAIL
  WEBAUTHN
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  entity      String
  details     String
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// PEOPLE (STUDENTS, TEACHERS, PARENTS)
// ============================================================================

model Student {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  admissionNumber String
  firstName       String
  lastName        String
  gender          Gender
  dateOfBirth     DateTime?
  photoUrl        String?
  
  classId         String?
  class           Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  
  guardianName    String
  guardianPhone   String
  status          StudentStatus @default(ACTIVE)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  parents             ParentStudent[]
  invoices            Invoice[]
  attendance          Attendance[]
  grades              Grade[]
  behaviorLogs        BehaviorLog[]
  healthRecord        HealthRecord?
  clinicVisits        ClinicVisit[]
  submissions         Submission[]
  bookLoans           BookLoan[]
  transportAssignment TransportAssignment?
  hostelAllocation    HostelAllocation?
  ptmBookings         PTMBooking[]
  gatePasses          GatePass[]
  wallet              StudentWallet?
  clubMemberships     ClubMembership[]
  dailyLogs           DailyLog[]
  examSeats           ExamSeat[]
  certificates        Certificate[]
  cbtAttempts         CBTAttempt[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
}

model TeacherProfile {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId  String
  specialization String?
  qualification  String?
  baseSalary  Float   @default(0)
  joinDate    DateTime @default(now())
  contractEndDate DateTime?
  deletedAt   DateTime?

  timetables    Timetable[]
  assignments   Assignment[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  ptmSlots      PTMSlot[]
  behaviorLogs  BehaviorLog[]
  dailyLogs     DailyLog[]
  absences      SubstituteAssignment[] @relation("AbsentTeacher")
  coverings     SubstituteAssignment[] @relation("CoverTeacher")

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("teacher_profiles")
}

model ParentProfile {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  occupation  String?
  address     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    ParentStudent[]

  @@index([tenantId])
  @@map("parent_profiles")
}

model ParentStudent {
  id             String        @id @default(cuid())
  parentId       String
  parent         ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relationship   String        @default("GUARDIAN")

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// ============================================================================
// ACADEMICS (CLASSES, SUBJECTS, TIMETABLE)
// ============================================================================

model Class {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  section     String
  capacity    Int     @default(40)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  students      Student[]
  timetables    Timetable[]
  attendance    Attendance[]
  assessments   Assessment[]
  announcements Announcement[]
  assignments   Assignment[]
  cbtExams      CBTExam[]

  @@unique([tenantId, name, section])
  @@index([tenantId])
  @@map("classes")
}

model Subject {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  code        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetables  Timetable[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

model Timetable {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek   Int
  startTime   String
  endTime     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  substituteAssignment SubstituteAssignment?

  @@index([tenantId, dayOfWeek])
  @@map("timetables")
}

// ============================================================================
// ATTENDANCE & ASSESSMENTS
// ============================================================================

model Attendance {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([tenantId, classId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Assessment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  title       String
  maxScore    Int      @default(100)
  date        DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  grades      Grade[]

  @@index([tenantId, classId])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score        Float

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([tenantId, studentId])
  @@map("grades")
}

// ============================================================================
// FINANCE
// ============================================================================

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title       String
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments    Payment[]

  @@index([tenantId, studentId])
  @@map("invoices")
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(10, 2)
  method      String
  reference   String?

  createdAt   DateTime @default(now())

  @@index([tenantId, invoiceId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  vendorName  String?
  date        DateTime @default(now())
  notes       String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, category])
  @@map("expenses")
}

// ============================================================================
// LMS (ASSIGNMENTS)
// ============================================================================

model Assignment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  title       String
  description String   @db.Text
  attachmentUrl String?
  dueDate     DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@index([tenantId, classId])
  @@map("assignments")
}

model Submission {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  content      String?    @db.Text
  fileUrl      String?
  grade        Float?
  feedback     String?    @db.Text
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
  @@map("submissions")
}

// ============================================================================
// ADVANCED CBT (COMPUTER-BASED TESTING) ENGINE
// ============================================================================

model CBTExam {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  title       String
  duration    Int      @default(30) // in minutes
  totalMarks  Int      @default(0)  // Automatically calculated

  startTime   DateTime
  endTime     DateTime

  createdAt   DateTime @default(now())
  questions   CBTQuestion[]
  attempts    CBTAttempt[]

  @@index([tenantId, classId])
  @@map("cbt_exams")
}

model CBTQuestion {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  examId      String
  exam        CBTExam  @relation(fields: [examId], references: [id], onDelete: Cascade)

  text        String   @db.Text
  options     Json     // Array of 4 strings
  correctOption Int    // 0, 1, 2, or 3
  marks       Int      @default(1)

  answers     StudentAnswer[]

  @@index([tenantId, examId])
  @@map("cbt_questions")
}

model CBTAttempt {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  examId      String
  exam        CBTExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score       Int      @default(0)
  status      String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DISQUALIFIED
  tabSwitches Int      @default(0)             // ANTI-CHEAT METRIC
  
  startedAt   DateTime @default(now())
  submittedAt DateTime?

  answers     StudentAnswer[]

  @@unique([examId, studentId])
  @@index([tenantId, studentId])
  @@map("cbt_attempts")
}

model StudentAnswer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  attemptId   String
  attempt     CBTAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  
  questionId  String
  question    CBTQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption Int

  @@unique([attemptId, questionId])
  @@map("student_answers")
}

// ============================================================================
// COMMUNICATION & NOTIFICATIONS
// ============================================================================

model Message {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content     String   @db.Text
  readAt      DateTime?

  createdAt   DateTime @default(now())

  @@index([tenantId, senderId, receiverId])
  @@map("messages")
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
