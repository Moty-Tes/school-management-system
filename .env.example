# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL="postgresql://sms:sms_dev_password@localhost:5433/sms?schema=public"

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL="redis://:sms_redis_password@localhost:6379"

# ============================================================================
# MINIO (S3-compatible file storage)
# ============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sms_minio
MINIO_SECRET_KEY=sms_minio_password
MINIO_BUCKET_PUBLIC=sms-public
MINIO_BUCKET_PRIVATE=sms-private

# ============================================================================
# MEILISEARCH (full-text search)
# ============================================================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=sms_meili_master_key

# ============================================================================
# JWT SECRETS
# ============================================================================
# Generate strong random strings for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d